# Server Configuration
PORT=3001
NODE_ENV=development

# Database (MongoDB)
# Exact variable name expected by the codebase: Mongodb_auth
Mongodb_auth=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/school_pj?retryWrites=true&w=majority

# Redis Cache & Rate Limiting
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# Cloudinary (Avatar Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# JWT Secrets (Optional, defaults exist in code if omitted)
ACCESS_TOKEN_SECRET=your_access_token_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
